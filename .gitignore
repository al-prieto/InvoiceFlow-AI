# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.env
.envrc
.venv
env/
venv/
ENV/

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Type checkers ─────────────────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/

# ── IDE / editors ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.cursorignore
*.cursorindexingignore

# ── Streamlit ─────────────────────────────────────────────────────────────────
# Contains secrets.toml — never commit this
.streamlit/

# ── Project outputs ───────────────────────────────────────────────────────────
# Generated Excel files should not be tracked
outputs/

# ── Sample data ───────────────────────────────────────────────────────────────
# Real invoice PDFs may contain sensitive data — keep out of version control.
# Add individual safe demo files explicitly with `git add -f` if needed.
data/samples/*.pdf

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db